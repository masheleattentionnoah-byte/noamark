{
  "redirects": [
    { "source": "/noamark-ai-agent.html", "destination": "/maya-ai-agent", "permanent": false },
    { "source": "/maya", "destination": "/maya-ai-agent", "permanent": false }
  ],
  "rewrites": [
    { "source": "/api/claude", "destination": "/api/claude" },
    { "source": "/maya-ai-agent", "destination": "/noamark-ai-agent.html" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "crons": [
    { "path": "/api/check-trials", "schedule": "0 6 * * *" },
    { "path": "/api/netcash-notify?action=fund-report", "schedule": "0 18 * * *" }
  ]
}
